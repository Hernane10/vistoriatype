              <label className="label block mb-1.5">Tipo de imóvel</label>
              <select className="select w-full px-4 py-2.5 text-sm" value={form.tipoImovel} onChange={(e) => set("tipoImovel", e.target.value)}>
                <option>Apartamento</option>
