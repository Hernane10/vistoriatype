          {locked && <span className="badge badge-good flex items-center gap-1"><CheckCircle2 size={11} /> Finalizada</span>}
        </div>

{/* INDICADOR DE ETAPAS */}
<div className="max-w-4xl mx-auto mb-6 no-print">
